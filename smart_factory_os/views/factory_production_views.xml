<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit MRP Production Form View -->
        <record id="view_mrp_production_factory_form_inherit" model="ir.ui.view">
            <field name="name">mrp.production.factory.form.inherit</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
            <field name="arch" type="xml">
                <!-- Add Quick Action Buttons to Header -->
                <xpath expr="//header" position="inside">
                    <button name="action_quick_material_requisition" string="📦 Request Raw Materials" type="object" class="btn-secondary" invisible="state in ['draft', 'cancel', 'done']"/>
                    <button name="action_pass_quality" string="✅ Sign QC Approval" type="object" class="btn-success" invisible="qc_passed or state in ['draft', 'cancel']"/>
                    <button name="action_shopfloor_produce_one_click" string="⚡ 1-Click Shopfloor Complete" type="object" class="btn-primary" invisible="state in ['done', 'cancel']" confirm="Are you sure you want to complete this batch and record finished output now?"/>
                </xpath>

                <!-- Add Stat Button Box entries -->
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button class="oe_stat_button" name="action_view_requisitions" type="object" icon="fa-truck">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value"><field name="requisition_count"/></span>
                            <span class="o_stat_text">Requisitions</span>
                        </div>
                    </button>
                </xpath>

                <!-- Batch Tracking Code under Title -->
                <xpath expr="//div[hasclass('oe_title')]" position="inside">
                    <div class="d-flex align-items-center gap-2 mt-2">
                        <span class="badge bg-dark px-2 py-1" style="font-size: 0.9rem;">
                            Batch Traveler: <field name="factory_batch_code" readonly="1" class="fw-bold"/>
                        </span>
                        <field name="factory_shift_id" placeholder="Select Production Shift" options="{'no_create': True}"/>
                        <field name="factory_supervisor_id" placeholder="Shift Supervisor" options="{'no_create': True}"/>
                        <span class="badge bg-danger ms-2" invisible="not is_scrap_alert">
                            ⚠️ High Scrap Alert: <field name="scrap_ratio_pct"/>%
                        </span>
                        <span class="badge bg-success ms-2" invisible="not qc_passed">
                            ✓ QC Approved
                        </span>
                    </div>
                </xpath>

                <!-- New Notebook Tabs: Costing & Shopfloor Equipment -->
                <xpath expr="//notebook" position="inside">
                    <!-- Tab 1: 4-Pillar Batch Costing & Profitability -->
                    <page string="💰 Factory Costing &amp; Profitability" name="factory_costing">
                        <div class="alert alert-info py-2" role="alert">
                            <strong>4-Pillar Live Manufacturing Cost Absorption:</strong> Dynamically calculates actual raw material consumption, operator labor, machine energy/depreciation, and factory overhead.
                        </div>
                        <div class="row g-3">
                            <!-- Left Column: The 4 Cost Pillars -->
                            <div class="col-12 col-md-6">
                                <div class="card p-3 border shadow-sm">
                                    <h6 class="fw-bold text-primary mb-3">Absorption Cost Breakdown</h6>
                                    <table class="table table-sm table-borderless">
                                        <tbody>
                                            <tr>
                                                <td><i class="fa fa-cubes me-2 text-muted"></i>Raw Materials Cost:</td>
                                                <td class="text-end fw-bold">€<field name="cost_raw_materials"/></td>
                                            </tr>
                                            <tr>
                                                <td><i class="fa fa-users me-2 text-muted"></i>Direct Operator Labor:</td>
                                                <td class="text-end fw-bold">€<field name="cost_direct_labor"/></td>
                                            </tr>
                                            <tr>
                                                <td><i class="fa fa-plug me-2 text-muted"></i>Machinery &amp; Power:</td>
                                                <td class="text-end fw-bold">€<field name="cost_machine_power"/></td>
                                            </tr>
                                            <tr>
                                                <td><i class="fa fa-building-o me-2 text-muted"></i>Factory Overhead Allocation:</td>
                                                <td class="text-end fw-bold">€<field name="cost_factory_overhead"/></td>
                                            </tr>
                                            <tr class="border-top">
                                                <td class="fw-bold fs-6">Total Batch Cost:</td>
                                                <td class="text-end fw-bold fs-6 text-dark">€<field name="cost_total_batch"/></td>
                                            </tr>
                                            <tr>
                                                <td class="fw-bold text-success fs-6">Unit Production Cost:</td>
                                                <td class="text-end fw-bold text-success fs-6">€<field name="cost_per_unit"/></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Right Column: Profitability & Suggested Price -->
                            <div class="col-12 col-md-6">
                                <div class="card p-3 border shadow-sm bg-light">
                                    <h6 class="fw-bold text-success mb-3">Profitability &amp; Pricing Engine</h6>
                                    <group>
                                        <field name="overhead_rate_pct" string="Overhead Factor (%)"/>
                                        <field name="target_margin_pct" string="Target Margin (%)"/>
                                        <field name="suggested_sale_price" string="Suggested Selling Price (€)" class="fw-bold text-primary"/>
                                        <field name="actual_product_price" string="Catalog List Price (€)"/>
                                        <field name="batch_margin_pct" string="Realized Batch Margin (%)" class="fw-bold text-success"/>
                                    </group>
                                </div>
                            </div>
                        </div>
                    </page>

                    <!-- Tab 2: Machinery & Quality Control -->
                    <page string="⚙️ Floor Machines &amp; Quality" name="factory_machines_qc">
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <h6 class="fw-bold mb-2">Assigned Production Machinery</h6>
                                <field name="factory_machine_ids" widget="many2many_tags" placeholder="Link active equipment on this line..."/>
                                <div class="mt-3">
                                    <h6 class="fw-bold mb-2">Scrap &amp; Defect Parameters</h6>
                                    <group>
                                        <field name="scrap_units" readonly="1"/>
                                        <field name="scrap_ratio_pct" readonly="1"/>
                                        <field name="scrap_threshold_pct"/>
                                    </group>
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <h6 class="fw-bold mb-2">Quality Assurance (QC) Inspection</h6>
                                <group>
                                    <field name="qc_inspected"/>
                                    <field name="qc_passed"/>
                                    <field name="qc_inspector_id"/>
                                    <field name="qc_inspection_notes" placeholder="Observations, tolerances, defect notes..."/>
                                </group>
                            </div>
                        </div>
                    </page>
                </xpath>
            </field>
        </record>

        <!-- Inherit MRP Production Tree View -->
        <record id="view_mrp_production_factory_tree_inherit" model="ir.ui.view">
            <field name="name">mrp.production.factory.tree.inherit</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="factory_batch_code" optional="show"/>
                    <field name="factory_shift_id" optional="show"/>
                </xpath>
                <xpath expr="//field[@name='state']" position="after">
                    <field name="cost_total_batch" optional="show" widget="monetary"/>
                    <field name="cost_per_unit" optional="show" widget="monetary"/>
                    <field name="batch_margin_pct" optional="show" widget="badge" decoration-success="batch_margin_pct &gt;= 25" decoration-warning="batch_margin_pct &lt; 25 and batch_margin_pct &gt; 0" decoration-danger="batch_margin_pct &lt;= 0"/>
                    <field name="qc_passed" optional="show" widget="boolean_toggle"/>
                </xpath>
            </field>
        </record>

        <!-- Simplified Shopfloor Operator Action -->
        <record id="action_factory_shopfloor_kiosk" model="ir.actions.act_window">
            <field name="name">Shop Floor Operator Kiosk</field>
            <field name="res_model">mrp.production</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('state', 'in', ['confirmed', 'progress'])]</field>
            <field name="context">{'search_default_todo': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No active production batches in progress!
                </p>
                <p>
                    Use the "Launch Production Batch" button to begin running shopfloor operations.
                </p>
            </field>
        </record>
    </data>
</odoo>
